{
  "outputDirectory": "out-static",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "source": "/(.*)",
      "destination": "/$1/index.html"
    }
  ],
  "errorPages": [
    {
      "status": 404,
      "src": "/404.html"
    }
  ]
}
