    "@sentry/vite-plugin": "^5.2.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.91.3",
    "@vercel/analytics": "^1.6.1",
    "@vitejs/plugin-react": "^4.3.3",
    "cross-env": "^7.0.3",
